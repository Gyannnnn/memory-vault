{
  "extends": "@memory-vault/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": false,
    "incremental": true
  },
  "include": ["next-env.d.ts", "src", "scripts", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
