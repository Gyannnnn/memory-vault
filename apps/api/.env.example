NODE_ENV=development
# Port the API listens on
API_PORT=4000
# Public base URL of the API
API_PUBLIC_URL=http://localhost:4000

# Connection as the non-superuser app role (row-level security enforced). Generated.
DATABASE_URL=
# Connection as the owner role, used only for migrations and admin scripts. Generated.
DATABASE_MIGRATE_URL=
# Redis for queues and rate limiting. Generated.
REDIS_URL=

# AWS region of the bucket and queue
AWS_REGION=ap-south-1
# Bucket name from the setup guide, step B1
S3_BUCKET=
# Queue URL from the setup guide, step D2
SQS_S3_EVENTS_QUEUE_URL=
# Access key of the memory-vault-app IAM user, step E3
AWS_ACCESS_KEY_ID=
# Secret of the memory-vault-app IAM user, step E3
AWS_SECRET_ACCESS_KEY=

# Ed25519 private key (PKCS8 PEM, base64) for signing access tokens. Generated.
JWT_PRIVATE_KEY=
# Matching Ed25519 public key (SPKI PEM, base64). Generated.
JWT_PUBLIC_KEY=
# 32-byte key (base64) encrypting TOTP secrets at rest. Generated. Losing it disables TOTP, not file access.
DATA_ENCRYPTION_KEY=

# WebAuthn relying party ID: the app's domain (localhost in development)
WEBAUTHN_RP_ID=localhost
# Name shown in passkey prompts
WEBAUTHN_RP_NAME=Memory Vault
# Allowed WebAuthn origins, comma-separated
WEBAUTHN_ORIGINS=http://localhost:3000

# closed | invite | open
SIGNUP_MODE=closed
# Default storage quota per user, in bytes (1 TiB)
DEFAULT_QUOTA_BYTES=1099511627776

# Host-path → worker-path mappings for local ingest, semicolon-separated "host=container" pairs. Generated from the root .env.
LOCAL_PATH_MAP=
