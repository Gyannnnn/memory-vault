# Base URL of the Memory Vault API
VAULT_API_URL=http://localhost:4000
# Where the CLI keeps its manifest database (defaults to ~/.local/share/memory-vault)
VAULT_DATA_DIR=
# Where phone files are staged before upload (defaults to ~/vault-staging)
VAULT_STAGING_DIR=
# Local ML service (docker compose --profile app up -d ml)
VAULT_ML_URL=http://127.0.0.1:8090
# Host folder → path inside the Docker services, semicolon-separated "host=container" pairs. Generated.
VAULT_CONTAINER_PATH_MAP=
