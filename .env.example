# Used by docker compose for local services. Generated by `pnpm secrets:init`.

# Postgres superuser password (local only; used for migrations)
POSTGRES_PASSWORD=
# Password of the non-superuser role the API connects as (row-level security applies to it)
VAULT_APP_DB_PASSWORD=
# Redis password
REDIS_PASSWORD=
# Host folder with a source being imported, mounted read-only into the worker (e.g. a laptop photo folder)
VAULT_LAPTOP_SOURCE_DIR=
# Host staging folder the CLI pulls phone files into, mounted read-only into the worker
VAULT_STAGING_DIR=
